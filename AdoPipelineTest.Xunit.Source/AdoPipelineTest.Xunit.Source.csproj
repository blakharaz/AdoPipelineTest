<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>Source-only xUnit v3 assertions for AdoPipelineTest - Unit test Azure DevOps YAML pipelines</Description>
        <PackageTags>azure-devops;yaml;pipelines;testing;xunit;source-only</PackageTags>
        <Authors>$(Authors)</Authors>
        <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
        <PackageProjectUrl>$(PackageProjectUrl)</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>1.0.0</Version>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <ContentTargetFolders>contentFiles</ContentTargetFolders>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AssertExtensions.cs" Pack="true" PackagePath="contentFiles/cs/netstandard2.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.assert.source" Version="3.2.2" PrivateAssets="all" />
        <PackageReference Include="AdoPipelineTest.Lib" Version="1.0.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AdoPipelineTest.Lib\AdoPipelineTest.Lib.csproj" />
    </ItemGroup>

</Project>
