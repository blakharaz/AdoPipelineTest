<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>xUnit assertions for AdoPipelineTest - Unit test Azure DevOps YAML pipelines</Description>
        <PackageTags>azure-devops;yaml;pipelines;testing;xunit</PackageTags>
        <Authors>$(Authors)</Authors>
        <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
        <PackageProjectUrl>$(PackageProjectUrl)</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit" Version="2.9.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AdoPipelineTest.Lib\AdoPipelineTest.Lib.csproj" />
    </ItemGroup>

</Project>
