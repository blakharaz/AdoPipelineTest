<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>FluentAssertions extensions for Azure DevOps Pipeline Testing Library</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Authors>Blakharaz</Authors>
        <PackageTags>azure-devops;yaml;pipelines;testing;fluentassertions</PackageTags>
        <RepositoryUrl>https://github.com/blakharaz/AdoPipelineTest</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AdoPipelineTest.Lib\AdoPipelineTest.Lib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
